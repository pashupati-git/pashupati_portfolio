---
import type { Project } from '../data/profile';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<div class="card project-card" data-reveal style={`--i:${Math.min(index, 4)}`}>
  <div>
    <div class="project-top">
      <div class="project-icon-box" style={project.color ? `border-color: ${project.color}40; box-shadow: 0 0 15px ${project.color}20` : ''}>
        {project.icon ? (
          <img src={project.icon} alt={project.name} width="52" height="52" loading="lazy" />
        ) : (
          <div style={`width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; color: #fff; background: ${project.color || 'var(--accent-gradient)'}`}>
            {project.name.slice(0, 2).toUpperCase()}
          </div>
        )}
      </div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        {project.installs && <span class="project-badge" style="color: var(--primary);">{project.installs}</span>}
        <span class="project-badge">{project.category}</span>
      </div>
    </div>

    <h3 class="project-title">{project.name}</h3>
    <p class="project-headline">{project.headline}</p>

    {project.previewScreen && (
      <div
        class="project-preview-wrap"
        role="button"
        tabindex="0"
        data-lightbox-src={project.previewScreen}
        data-lightbox-title={project.name}
        data-lightbox-desc={project.headline}
        aria-label={`Tap to view full screenshot of ${project.name}`}
      >
        <img src={project.previewScreen} alt={`${project.name} app interface`} class="card-screen-img" loading="lazy" />
        <span class="preview-badge">Production Flutter UI</span>
        <div class="preview-zoom-overlay">
          <span class="preview-zoom-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span>Tap for Full View</span>
          </span>
        </div>
      </div>
    )}

    <div class="project-stack">
      {project.stack.map((tech) => (
        <span class="tech-tag">{tech}</span>
      ))}
    </div>

    <ul class="project-bullets">
      {project.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
  </div>

  <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between;">
    <span style="font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-muted);">{project.period}</span>
    {project.link ? (
      <a href={project.link.url} target="_blank" rel="noopener" class="link-arrow" style="font-size: 0.88rem;">
        {project.link.label} <span class="arrow">↗</span>
      </a>
    ) : (
      <span style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">
        {project.status || 'Private Client / Academic'}
      </span>
    )}
  </div>
</div>

<style>
  .project-preview-wrap {
    margin: 1.1rem 0 0.8rem 0;
    border-radius: 14px;
    overflow: hidden;
    height: 170px;
    border: 1px solid var(--border-medium);
    background: #000;
    position: relative;
    cursor: pointer;
    outline-offset: 2px;
  }

  .project-preview-wrap:focus-visible {
    outline: 2px solid var(--primary);
  }

  .card-screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--transition-normal);
  }

  .project-preview-wrap:hover .card-screen-img {
    transform: scale(1.05);
  }

  .preview-zoom-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-fast);
    backdrop-filter: blur(2px);
  }

  .project-preview-wrap:hover .preview-zoom-overlay {
    opacity: 1;
  }

  .preview-zoom-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(15, 23, 42, 0.9);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 600;
    transform: translateY(4px);
    transition: transform var(--transition-fast);
  }

  .project-preview-wrap:hover .preview-zoom-btn {
    transform: translateY(0);
  }

  .preview-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 600;
    background: rgba(10, 14, 22, 0.85);
    color: var(--primary);
    padding: 3px 8px;
    border-radius: 6px;
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-subtle);
    z-index: 5;
    transition: opacity var(--transition-fast);
  }

  .project-preview-wrap:hover .preview-badge {
    opacity: 0;
  }
</style>
