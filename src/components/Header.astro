---
import { site, nav } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="brand-link" aria-label={`${site.name} Home`}>
      <span class="brand-badge">PC</span>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main Navigation">
      <ul class="nav-links">
        {nav.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = pathname === itemPath || (itemPath !== '/' && pathname.startsWith(itemPath));
          return (
            <li>
              <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <a href="/contact/" class="btn btn-secondary" style="padding: 0.5rem 1.1rem; font-size: 0.88rem;">
        Get in touch
      </a>
    </div>
  </div>
</header>
