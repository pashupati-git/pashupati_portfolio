---
import { site, nav } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="brand-link" aria-label={`${site.name} Home`}>
      <span class="brand-badge">PC</span>
      <span class="brand-text">{site.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        {nav.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = pathname === itemPath || (itemPath !== '/' && pathname.startsWith(itemPath));
          return (
            <li>
              <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <ThemeToggle />
      <a href="/contact/" class="btn btn-secondary desktop-cta" style="padding: 0.45rem 1rem; font-size: 0.85rem;">
        Get in touch
      </a>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobileMenuToggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        onclick="window.toggleMobileDrawer && window.toggleMobileDrawer()"
      >
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
        <span class="hamburger-line line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="container mobile-drawer-content">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-nav-links">
          {nav.map((item) => {
            const itemPath = item.href.replace(/\/$/, '') || '/';
            const isActive = pathname === itemPath || (itemPath !== '/' && pathname.startsWith(itemPath));
            return (
              <li>
                <a href={item.href} class={`mobile-nav-link ${isActive ? 'active' : ''}`} onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(false)">
                  <span>{item.label}</span>
                  <span class="mobile-nav-arrow">›</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <a href="/contact/" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.75rem 1.25rem;" onclick="window.toggleMobileDrawer && window.toggleMobileDrawer(false)">
          Get in touch
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    padding: 0;
    transition: all var(--transition-fast);
  }

  .mobile-menu-btn:hover {
    border-color: var(--primary);
  }

  .hamburger-line {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
    pointer-events: none;
  }

  .mobile-menu-btn[aria-expanded="true"] .line-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-btn[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .mobile-menu-btn[aria-expanded="true"] .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 999;
    background: var(--bg-surface);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--border-medium);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    padding: 1rem 0 1.5rem;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
  }

  .mobile-drawer.open {
    opacity: 1 !important;
    transform: translateY(0) !important;
    pointer-events: auto !important;
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 1rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .mobile-nav-link.active {
    color: var(--primary);
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, var(--bg-surface));
  }

  .mobile-nav-arrow {
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .desktop-nav,
    .desktop-cta {
      display: none !important;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-drawer {
      display: block;
    }

    .brand-text {
      font-size: 1.05rem;
    }
  }
</style>

<script is:inline>
  window.toggleMobileDrawer = function(forceState) {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const drawer = document.getElementById('mobileDrawer');
    if (!toggleBtn || !drawer) return;

    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    const targetState = typeof forceState === 'boolean' ? forceState : !isExpanded;

    toggleBtn.setAttribute('aria-expanded', String(targetState));
    drawer.setAttribute('aria-hidden', String(!targetState));
    if (targetState) {
      drawer.classList.add('open');
    } else {
      drawer.classList.remove('open');
    }
  };

  document.addEventListener('click', function(e) {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const drawer = document.getElementById('mobileDrawer');
    if (!toggleBtn || !drawer) return;

    if (toggleBtn.getAttribute('aria-expanded') === 'true') {
      if (!drawer.contains(e.target) && !toggleBtn.contains(e.target)) {
        window.toggleMobileDrawer(false);
      }
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.toggleMobileDrawer && window.toggleMobileDrawer(false);
    }
  });
</script>
