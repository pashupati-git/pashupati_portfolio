---
// Lightbox.astro - Fullscreen responsive mobile app screenshot viewer
---

<div id="app-lightbox" class="lightbox-backdrop" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="lightbox-overlay" id="lightbox-overlay"></div>

  <div class="lightbox-container">
    <!-- Top Header -->
    <div class="lightbox-header">
      <div class="lightbox-info">
        <span class="lightbox-tag" id="lightbox-badge">Production Flutter UI</span>
        <h3 class="lightbox-title" id="lightbox-title">Application</h3>
        <p class="lightbox-desc" id="lightbox-desc">Full interface screenshot</p>
      </div>

      <button type="button" class="lightbox-close-btn" id="lightbox-close" aria-label="Close full view (Esc)" title="Close (Esc)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Phone Frame & Navigation -->
    <div class="lightbox-body">
      <button type="button" class="lightbox-nav-btn prev" id="lightbox-prev" aria-label="Previous app screenshot" title="Previous (←)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Smartphone Container - Hugs the exact dimensions of the image with zero letterboxing -->
      <div class="lightbox-phone-wrapper">
        <div class="lightbox-phone-frame">
          <img id="lightbox-img" src="" alt="Full App Screenshot" class="lightbox-screenshot" />
        </div>
      </div>

      <button type="button" class="lightbox-nav-btn next" id="lightbox-next" aria-label="Next app screenshot" title="Next (→)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Footer Counter & Hint -->
    <div class="lightbox-footer">
      <div class="lightbox-counter-pill" id="lightbox-counter">1 / 6</div>
      <span class="lightbox-hint">Use ← / → arrow keys to navigate · Esc or click outside to close</span>
    </div>
  </div>
</div>

<style>
  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 14, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .lightbox-container {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: auto;
    max-width: 95vw;
    max-height: 96vh;
    padding: 0.75rem 1rem;
    transform: scale(0.94) translateY(8px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-backdrop.is-open .lightbox-container {
    transform: scale(1) translateY(0);
  }

  .lightbox-header {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding: 0 0.25rem;
    gap: 1.5rem;
  }

  .lightbox-info {
    flex: 1;
  }

  .lightbox-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--primary);
    background: rgba(0, 210, 180, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(0, 210, 180, 0.25);
    margin-bottom: 0.25rem;
  }

  .lightbox-title {
    font-size: 1.25rem;
    color: #fff;
    margin: 0;
    line-height: 1.25;
  }

  .lightbox-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
    line-height: 1.35;
  }

  .lightbox-close-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg) scale(1.05);
  }

  .lightbox-body {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    position: relative;
  }

  .lightbox-nav-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
  }

  .lightbox-nav-btn:hover {
    background: var(--primary);
    color: #000;
    border-color: var(--primary);
    box-shadow: 0 0 18px var(--primary-glow);
    transform: scale(1.08);
  }

  /* Seamless Phone Wrapper: Wraps exactly around the screenshot with zero black letterbox gaps */
  .lightbox-phone-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-phone-frame {
    display: inline-flex;
    background: #000;
    border: 4px solid #2d3748;
    border-radius: 28px;
    overflow: hidden;
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.8),
      0 0 45px rgba(0, 210, 180, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    line-height: 0;
  }

  .lightbox-screenshot {
    display: block;
    height: auto;
    max-height: min(74vh, 760px);
    width: auto;
    max-width: min(85vw, 380px);
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .lightbox-counter-pill {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--primary);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .lightbox-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .lightbox-body {
      gap: 0.6rem;
    }

    .lightbox-screenshot {
      max-height: 68vh;
      max-width: 78vw;
    }

    .lightbox-nav-btn {
      width: 38px;
      height: 38px;
    }

    .lightbox-title {
      font-size: 1.1rem;
    }

    .lightbox-desc {
      font-size: 0.78rem;
    }

    .lightbox-hint {
      display: none;
    }
  }
</style>
