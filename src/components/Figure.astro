---
interface Props {
  value: string;
}

const { value } = Astro.props;
---

<div class="container" data-reveal style="--i:3">
  <div class="card figure-banner">
    <div class="figure-num">
      {value}
    </div>
    <div class="figure-desc">
      <slot />
    </div>
  </div>
</div>

<style>
  .figure-banner {
    margin: 2.25rem 0;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 2rem 2.25rem;
    border-radius: var(--radius-lg);
  }

  .figure-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 900;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    flex-shrink: 0;
  }

  .figure-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 65ch;
  }

  @media (max-width: 640px) {
    .figure-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1.35rem 1.15rem;
      margin: 1.5rem 0;
    }

    .figure-num {
      font-size: 2.35rem;
    }

    .figure-desc {
      font-size: 0.92rem;
      line-height: 1.55;
    }
  }
</style>
