---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/profile';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>;
}

const { title, description = site.description, schema } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(site.photo, Astro.site ?? site.url).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  telephone: site.phone,
  jobTitle: 'Flutter Developer & Mobile Application Engineer',
  description: site.description,
  nationality: 'Nepali',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kathmandu',
    addressRegion: 'Bagmati Province',
    addressCountry: 'NP',
  },
  knowsAbout: [
    'Flutter',
    'Dart',
    'Mobile Application Development',
    'Android Development',
    'Kotlin',
    'iOS Development',
    'Riverpod',
    'Bloc',
    'Clean Architecture',
    'REST APIs',
    'Firebase',
    'ExoPlayer',
    'Google Play Store Publishing',
    'Apple App Store Publishing',
    'Mobile App QA & Testing',
    'Codemagic CI/CD',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Flutter Developer',
    description: 'Mobile application developer engineering Android and iOS applications with Flutter and native Kotlin in Nepal.',
    occupationLocation: {
      '@type': 'Country',
      name: 'Nepal',
    },
    skills: 'Flutter, Dart, Kotlin, Android, iOS, Clean Architecture, Riverpod, Mobile App Publishing',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Nepal Engineering College' },
    { '@type': 'EducationalOrganization', name: 'White House Secondary School' },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Classic Tech',
    url: 'https://classic.com.np',
  },
  sameAs: [site.links.linkedin, site.links.github],
  image: ogImage,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#08090d" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geo / Local SEO Metadata for Nepal -->
    <meta name="geo.region" content="NP-BA" />
    <meta name="geo.placename" content="Kathmandu, Nepal" />
    <meta name="geo.position" content="27.7089;85.3123" />
    <meta name="ICBM" content="27.7089, 85.3123" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Anti-flicker Theme Init Script -->
    <script is:inline>
      (() => {
        const apply = () => {
          const root = document.documentElement;
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (!theme) {
            theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          if (theme === 'light') {
            root.dataset.theme = 'light';
          } else {
            delete root.dataset.theme;
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />

    <script>
      import '../scripts/reveal.ts';
      import '../scripts/theme.ts';
      import '../scripts/glass.ts';
      import '../scripts/lightbox.ts';
    </script>
  </body>
</html>
