---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Phone3D from '../components/Phone3D.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects, experience, services, playListings } from '../data/profile';

const featuredProjects = projects.filter((p) => p.featured);
const currentRole = experience[0];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base schema={websiteSchema}>
  <!-- Hero Section with 3D Smartphone Centerpiece -->
  <Hero
    eyebrow="Flutter & Kotlin · Mobile Application Engineer"
    title="Pashupati Chaudhary."
    accent="Crafting high-performance mobile apps."
    lede="Computer Engineering graduate and Mobile Application Developer at Classic Tech. Primarily focused on production Flutter with strong flexibility in native Android (Kotlin)—owning the full lifecycle from architecture and UI execution, through rigorous testing, to automated CI/CD and release publishing on Google Play Store & Apple App Store."
  >
    <Fragment slot="actions">
      <a class="btn" href="/work/">
        Explore Work
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a class="btn btn-secondary" href="/cv/">
        View Full CV
      </a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>
        Email Me
      </a>
    </Fragment>

    <div slot="media">
      <Phone3D />
    </div>

    <!-- On Google Play App Badges -->
    <div style="margin-top: 2rem;" data-reveal style="--i:4">
      <p style="font-size: 0.82rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
        Contributed to Apps on Google Play
      </p>
      <div style="display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
        {playListings.map((app) => (
          <a href={app.url} target="_blank" rel="noopener" title={app.name} class="project-icon-box" style="width: 44px; height: 44px; transition: transform 0.2s ease;">
            <img src={app.icon} alt={app.name} width="44" height="44" />
          </a>
        ))}
      </div>
    </div>
  </Hero>

  <!-- Impact Stat Figure Banner -->
  <div class="container" data-reveal style="--i:1">
    <div class="stats-banner">
      <div class="stat-item">
        <div class="stat-num">110K+</div>
        <div class="stat-label">Google Play Installs across ISP & enterprise apps</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">10+</div>
        <div class="stat-label">Mobile & Web Applications engineered & contributed</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-label">Clean Architecture, MVVM & Riverpod state isolation</div>
      </div>
    </div>
  </div>

  <!-- Featured Projects Grid -->
  <Section id="projects" tag="Portfolio" heading="Featured Projects" description="Mobile and fullstack applications built from concept to deployment.">
    <div slot="header-actions">
      <a href="/work/" class="link-arrow">
        Browse all projects <span class="arrow">›</span>
      </a>
    </div>

    <div class="projects-grid">
      {featuredProjects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </Section>

  <!-- Profile Spotlight Card with photo main.jpeg -->
  <div class="container" style="margin: 2.5rem auto; --i: 2;" data-reveal>
    <div class="card spotlight-card">
      <div class="spotlight-avatar-box">
        <img src={site.photo} alt={site.name} class="spotlight-avatar-img" />
      </div>
      <div class="spotlight-content">
        <div class="spotlight-badge">
          <span class="pulse-dot"></span>
          <span>Currently at {currentRole.company} · {currentRole.title}</span>
        </div>
        <h3 class="spotlight-name">{site.name}</h3>
        <p class="spotlight-bio">
          {currentRole.bullets[0]} {currentRole.bullets[1]}
        </p>
        <div class="spotlight-actions">
          <a href="/about/" class="spotlight-btn spotlight-btn-secondary">
            <span>Read full background</span>
            <span class="arrow">›</span>
          </a>
          <a href="/cv/" class="spotlight-btn spotlight-btn-secondary">
            <span>Inspect CV</span>
            <span class="arrow">›</span>
          </a>
          <a href={site.whatsapp.url} target="_blank" rel="noopener" class="spotlight-btn spotlight-btn-primary">
            <span>Quick WhatsApp</span>
            <span class="arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- What I Take On / Services Grid -->
  <Section id="services" tag="Expertise" heading="What I Take On" tone="soft" description="Specialized mobile engineering capabilities I bring to product teams.">
    <div class="services-grid">
      {services.map((service, i) => (
        <div class="card service-card" data-reveal style={`--i:${Math.min(i, 4)}`}>
          <div class="service-icon">{service.icon}</div>
          <h3 style="font-size: 1.25rem;">{service.title}</h3>
          <p style="font-size: 0.95rem; line-height: 1.6;">{service.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Education & Journey Quick Overview -->
  <Section id="journey" tag="Foundations" heading="Academic & Engineering Foundation">
    <div class="card" data-reveal style="--i:1">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--primary);">2021 — 2025</span>
          <h3 style="font-size: 1.35rem; margin-top: 0.25rem;">Bachelor in Computer Engineering</h3>
          <p style="color: var(--text-secondary); margin-top: 0.35rem;">
            Nepal Engineering College (Affiliated with Pokhara University), Changunarayan, Bhaktapur.
          </p>
        </div>
        <a href="/about/#education" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
          View All Degrees
        </a>
      </div>
      <p style="margin-top: 1rem; font-size: 0.95rem; color: var(--text-secondary); border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
        Solid grounding in Data Structures, Algorithms, Object-Oriented Software Design, Operating Systems, Computer Networks, and Machine Learning. Transitioned from C++ and Java into MERN web development and production Flutter engineering.
      </p>
    </div>
  </Section>
</Base>

<style>
  .spotlight-card {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: 24px;
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .spotlight-card:hover {
    border-color: var(--border-glow);
    box-shadow: var(--shadow-lg), 0 0 25px var(--primary-glow);
  }

  .spotlight-avatar-box {
    width: 135px;
    height: 135px;
    border-radius: 22px;
    overflow: hidden;
    border: 2px solid var(--primary);
    box-shadow: 0 8px 24px -4px var(--primary-glow);
    flex-shrink: 0;
    background: var(--bg-subtle);
  }

  .spotlight-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .spotlight-content {
    flex: 1;
    min-width: 280px;
  }

  .spotlight-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.85rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 32%, transparent);
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.65rem;
  }

  .spotlight-name {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
    line-height: 1.25;
  }

  .spotlight-bio {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 1.25rem 0;
  }

  .spotlight-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .spotlight-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 0.42rem 1rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .spotlight-btn-secondary {
    background: var(--bg-subtle);
    color: var(--text-main);
    border: 1px solid var(--border-medium);
  }

  .spotlight-btn-secondary:hover {
    background: var(--primary);
    color: #ffffff;
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px var(--primary-glow);
  }

  .spotlight-btn-primary {
    background: var(--primary);
    color: #ffffff;
    border: 1px solid var(--primary);
    box-shadow: 0 4px 14px var(--primary-glow);
  }

  .spotlight-btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--primary-glow);
  }

  .spotlight-btn .arrow {
    transition: transform var(--transition-fast);
  }

  .spotlight-btn:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .spotlight-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .spotlight-avatar-box {
      width: 100px;
      height: 100px;
    }
  }
</style>
