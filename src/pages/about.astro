---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { site, education, certifications, skills, languages } from '../data/profile';

const title = 'About';
const description =
  'About Pashupati Chaudhary, Flutter Developer & Computer Engineering graduate based in Kathmandu. Academic background, technical skillset, and software development journey.';
---

<Base title={title} description={description}>
  <Hero
    small
    eyebrow="Background & Journey"
    title="Engineering with Precision."
    accent="From foundational algorithms to mobile architectures."
    lede="A Computer Engineering graduate passionate about building intuitive, high-performance mobile applications that solve tangible problems."
  >
    <Fragment slot="actions">
      <a class="btn" href="/cv/">Read Curriculum Vitae</a>
      <a class="btn btn-secondary" href="/contact/">Get in touch</a>
    </Fragment>
  </Hero>

  <!-- Profile & Story Split -->
  <div class="container" style="margin-top: 2rem;">
    <div class="card about-hero-grid" data-reveal style="--i:1;">
      <div style="text-align: center;">
        <div style="width: 240px; height: 280px; margin: 0 auto; border-radius: var(--radius-lg); overflow: hidden; border: 2px solid var(--border-glow); box-shadow: 0 10px 30px var(--primary-glow);">
          <img src={site.photo} alt={site.name} style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <div style="margin-top: 1rem;">
          <h3 style="font-size: 1.25rem;">{site.name}</h3>
          <p style="font-size: 0.88rem; font-family: var(--font-mono); color: var(--primary);">{site.location}</p>
        </div>
      </div>

      <div>
        <span class="section-tag">Software Philosophy</span>
        <h2 style="font-size: 1.75rem; margin-bottom: 1.25rem;">Building code that scales gracefully</h2>
        <div class="prose" style="display: flex; flex-direction: column; gap: 1rem; color: var(--text-secondary); line-height: 1.7;">
          <p>
            My programming journey began with foundational systems languages like C++ and Java, where I developed a rigorous understanding of Object-Oriented Programming, memory management, and Data Structures & Algorithms.
          </p>
          <p>
            After exploring fullstack web development with the MERN stack (MongoDB, Express, React, Node.js), I found my true passion in cross-platform mobile engineering. The ability to craft fluid 60fps and 120fps mobile experiences from a unified Flutter codebase captivated me.
          </p>
          <p>
            At MindRisers Institute of Technology, I have applied this passion to production apps using Clean Architecture, Riverpod, and Hive. To me, a great app is not just about visual finesse—it is about robust error handling, offline-first reliability, predictable state management, and respecting user device constraints.
          </p>
        </div>
      </div>
    </div>
  </div>

  <Figure value="4+ Years">
    of disciplined computer engineering education, hands-on apprenticeship, and production mobile application development.
  </Figure>

  <!-- Complete Education Timeline -->
  <Section id="education" tag="Academia" heading="Formal Education">
    <div class="timeline-list">
      {education.map((item, index) => (
        <Entry title={item.degree} meta={item.period} index={index}>
          <Fragment slot="org">
            {item.institutionUrl ? (
              <a href={item.institutionUrl} target="_blank" rel="noopener">{item.institution}</a>
            ) : (
              item.institution
            )}, {item.location}
          </Fragment>
          <p>{item.details}</p>
        </Entry>
      ))}
    </div>
  </Section>

  <!-- Training & Certifications -->
  <Section id="certifications" tag="Professional Development" heading="Training & Certifications" tone="soft">
    <div class="timeline-list">
      {certifications.map((item, index) => (
        <Entry title={item.title} meta={item.period} index={index}>
          <Fragment slot="org">{item.issuer}</Fragment>
          <p>{item.details}</p>
        </Entry>
      ))}
    </div>
  </Section>

  <!-- Technical Skills Matrix -->
  <Section id="skills" tag="Capabilities" heading="Technical Skills Matrix">
    <div class="skills-group-grid">
      {skills.map((group, i) => (
        <div class="card" data-reveal style={`--i:${i}`}>
          <h3 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 0.75rem;">{group.category}</h3>
          <div class="skill-pill-list">
            {group.items.map((skill) => (
              <span class="skill-pill">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Spoken Languages -->
  <Section id="languages" tag="Communication" heading="Languages" tone="soft">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;" data-reveal>
      {languages.map((lang) => (
        <div class="card" style="text-align: center; padding: 1.5rem;">
          <h3 style="font-size: 1.35rem; margin-bottom: 0.35rem;">{lang.name}</h3>
          <p style="font-size: 0.9rem; font-family: var(--font-mono); color: var(--primary);">{lang.level}</p>
        </div>
      ))}
    </div>
    <div style="margin-top: 2.5rem; text-align: center;" data-reveal>
      <a href="/cv/" class="btn">View Full Printable CV</a>
    </div>
  </Section>
</Base>
