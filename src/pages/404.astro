---
import Base from '../layouts/Base.astro';

const title = 'Page Not Found';
const description = 'The requested page could not be located on Pashupati Chaudhary’s portfolio.';
---

<Base title={title} description={description}>
  <div class="container container-narrow" style="padding: 6rem 1.5rem; text-align: center;">
    <div class="hero-eyebrow" data-reveal style="--i:0">
      <span>Error 404</span>
    </div>

    <h1 style="font-size: clamp(3rem, 7vw, 6rem); margin: 1rem 0; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      404
    </h1>

    <h2 style="font-size: 1.75rem; margin-bottom: 1rem;" data-reveal style="--i:1">
      Screen not found in route stack.
    </h2>

    <p style="margin: 0 auto 2rem; color: var(--text-secondary); max-width: 50ch;" data-reveal style="--i:2">
      The route you navigated to has been popped from the navigator history or does not exist.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;" data-reveal style="--i:3">
      <a class="btn" href="/">Return to Home</a>
      <a class="btn btn-secondary" href="/work/">View Work</a>
    </div>
  </div>
</Base>
